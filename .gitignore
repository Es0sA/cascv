.playwright-mcp/

# ============================================================
# OS metadata
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# Editor / IDE
# ============================================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.viminfo
*.sublime-project
*.sublime-workspace

# ============================================================
# Logs
# ============================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log*

# ============================================================
# Environment variables (never commit secrets)
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Temporary files and caches
# ============================================================
*.tmp
*.temp
.cache/
tmp/
temp/

# ============================================================
# Client-specific
# ============================================================
node_modules/
# Firebase Hosting deploy artifacts (if firebase init is ever run)
.firebase/
# Local dev server artifacts
*.pid
nohup.out

# Security and keys
*.pem
*.key
*service-account*.json
*credentials*.json
